# === code-push-server (GCP + R2) 환경변수 템플릿 ===
# 이 파일을 .env 로 복사한 뒤 실제 값으로 채우세요. (.env 는 커밋 금지 — .gitignore에 포함됨)
#   cp .env.example .env && nano .env

# JWT 시크릿:  openssl rand -hex 32  로 생성한 값
TOKEN_SECRET=

# ── 외부 GCP MySQL (1단계에서 만든 codepush 전용 DB/유저) ──
RDS_HOST=                     # Cloud SQL Private IP 또는 자체 MySQL 내부 IP
RDS_PORT=3306
RDS_USERNAME=codepush
RDS_PASSWORD=
DATA_BASE=codepush            # DB(스키마) 이름

# ── Cloudflare R2 (S3 호환 스토리지) ──
AWS_ACCESS_KEY_ID=            # R2 API 토큰 Access Key
AWS_SECRET_ACCESS_KEY=        # R2 API 토큰 Secret
BUCKET_NAME=codepush-bundles
S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
DOWNLOAD_URL=https://collabpie-cp.plugpool.com
